:80 {
    # Reverse proxy for backend API endpoints and Swagger documentation
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /docs* {
        reverse_proxy backend:8000
    }

    handle /openapi.json {
        reverse_proxy backend:8000
    }

    handle /redoc* {
        reverse_proxy backend:8000
    }

    # Reverse proxy for frontend application (supports Vite HMR WebSocket transparently)
    handle {
        reverse_proxy frontend:5173
    }
}



