# PostgreSQL Configuration
POSTGRES_DB=login_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password

# Backend Database URL (pointing to postgres service in Docker network)
DATABASE_URL=postgresql://postgres:your_database_password@postgres:5432/login_db

# JWT Authentication
SECRET_KEY=your_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
    